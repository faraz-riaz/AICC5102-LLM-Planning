# Copy this file to .env. Never commit the resulting .env file.

# gemini | openai | deepseek | nvidia
LLM_PROVIDER=gemini

# Gemini Developer API: set one key. GOOGLE_API_KEY takes precedence if both exist.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud alternative: set true to use Vertex AI and Application Default
# Credentials instead of an API key. Run `gcloud auth application-default login`
# for local development, or use an attached workload/service-account identity.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v3

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=kimi-k2.5
