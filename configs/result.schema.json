{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aicc5102/result.schema.json",
  "title": "AICC5102 planning result record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp",
    "git_commit",
    "config_id",
    "domain",
    "problem_id",
    "difficulty",
    "algorithm",
    "heuristic_id",
    "heuristic_trial_id",
    "heuristic_weight",
    "seed",
    "status",
    "solved",
    "plan_valid",
    "plan_length",
    "plan_cost",
    "nodes_expanded",
    "wall_time_s",
    "peak_memory_mb",
    "time_limit_s",
    "memory_limit_mb",
    "optimal_cost",
    "optimality_proven",
    "machine_id"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "minLength": 7},
    "config_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["blocksworld", "miconic", "transport"]},
    "problem_id": {"type": "string", "minLength": 1},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "algorithm": {"type": "string", "minLength": 1},
    "heuristic_id": {"type": "string", "minLength": 1},
    "heuristic_trial_id": {"type": ["string", "null"]},
    "heuristic_weight": {"type": ["number", "null"]},
    "seed": {"type": "integer"},
    "status": {"enum": ["success", "unsolved", "timeout", "memory_limit", "invalid_plan", "error"]},
    "solved": {"type": "boolean"},
    "plan_valid": {"type": ["boolean", "null"]},
    "plan_length": {"type": ["integer", "null"], "minimum": 0},
    "plan_cost": {"type": ["number", "null"], "minimum": 0},
    "nodes_expanded": {"type": ["integer", "null"], "minimum": 0},
    "wall_time_s": {"type": "number", "minimum": 0},
    "peak_memory_mb": {"type": ["number", "null"], "minimum": 0},
    "time_limit_s": {"type": "number", "exclusiveMinimum": 0},
    "memory_limit_mb": {"type": "integer", "exclusiveMinimum": 0},
    "optimal_cost": {"type": ["number", "null"], "minimum": 0},
    "optimality_proven": {"type": "boolean"},
    "machine_id": {"type": "string", "minLength": 1}
  }
}
